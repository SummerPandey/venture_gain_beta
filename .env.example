# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — these are safe to expose in the client bundle (anon key is
# public by design; security comes from Row Level Security policies).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq — SERVER-SIDE secret. No VITE_ prefix, so it is NOT bundled into the
# client. Used by /api/groq (production) and the dev proxy in vite.config.ts.
GROQ_API_KEY=
