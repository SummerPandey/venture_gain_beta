# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — these are safe to expose in the client bundle (anon key is
# public by design; security comes from Row Level Security policies).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq — SERVER-SIDE secret. No VITE_ prefix, so it is NOT bundled into the
# client. Used by /api/groq (production) and the dev proxy in vite.config.ts.
GROQ_API_KEY=

# Gemini — SERVER-SIDE secret, used for vision (food/workout photo scanning)
# since Groq deprecated its vision models. Used by /api/gemini (production)
# and the dev proxy in vite.config.ts.
GEMINI_API_KEY=

# Google Health API (Fitbit/Google Fit data) — from a Google Cloud Console
# OAuth 2.0 Client ID ("Web application" type), with ALL of these readonly
# scopes added under Data Access (requested together on purpose, so one
# reconnect covers whatever gets built next — heart rate, resting HR, weight,
# body fat, and HRV all live under health_metrics_and_measurements):
#   googlehealth.activity_and_fitness.readonly
#   googlehealth.sleep.readonly
#   googlehealth.health_metrics_and_measurements.readonly
# CLIENT_ID is also needed in the browser to build the consent-screen link, so
# it's duplicated as VITE_ below; CLIENT_SECRET must never get a VITE_ prefix.
# REFRESH_TOKEN is obtained by visiting /api/google-health-callback's
# "Connect" link once (redo it if you add a scope after already connecting —
# an old token won't cover the new scope) — see README for the full setup
# checklist. Used by /api/google-health-* (production) and the dev proxies in
# vite.config.ts.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REFRESH_TOKEN=
VITE_GOOGLE_HEALTH_CLIENT_ID=
